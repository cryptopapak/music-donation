# ============================================
# 🚀 БЫСТРЫЙ ЗАПУСК (MOCK РЕЖИМ - БЕЗ SUPABASE)
# ============================================
# Для быстрого запуска просто раскомментируйте строку ниже:
# NEXT_PUBLIC_USE_MOCK=true

# ============================================
# 🔧 ПОДКЛЮЧЕНИЕ SUPABASE (ПРОДАКШЕН)
# ============================================
# 1. Создайте проект на https://supabase.com
# 2. Скопируйте URL и ключи из Project Settings
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ============================================
# 🔐 TWITCH AUTH (ОБЯЗАТЕЛЬНО ДЛЯ СТРЕЙМЕРОВ)
# ============================================
# 1. Создайте приложение на https://dev.twitch.tv/console
# 2. Скопируйте Client ID и Client Secret
# TWITCH_CLIENT_ID=your-twitch-client-id
# TWITCH_CLIENT_SECRET=your-twitch-client-secret
# TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ============================================
# 💳 ПЛАТЕЖНЫЕ СИСТЕМЫ
# ============================================
# Mock режим отключен для реальных платежей
NEXT_PUBLIC_USE_MOCK=false
PAYMENT_PROVIDER=yookassa

# Для реальных платежей настройте ЮKassa:
YUKASSA_SHOP_ID=your-yukassa-shop-id
YUKASSA_SECRET_KEY=your-yukassa-secret-key

# Или CloudPayments:
# CLOUDPAYMENTS_PUBLIC_ID=your-public-id
# CLOUDPAYMENTS_SECRET_KEY=your-secret-key

# ============================================
# 🌐 APP URL
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000