# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Payment (Mock by default, can switch to YuKassa/CloudPayments)
PAYMENT_PROVIDER=mock
YUKASSA_SHOP_ID=your-yukassa-shop-id
YUKASSA_SECRET_KEY=your-yukassa-secret-key
YUKASSA_WEBHOOK_SECRET=your-yukassa-webhook-secret
CLOUDPAYMENTS_PUBLIC_ID=your-cloudpayments-public-id
CLOUDPAYMENTS_SECRET_KEY=your-cloudpayments-secret-key

# App
NEXT_PUBLIC_APP_URL=https://music-donation.vercel.app

# Metadata Parser (YouTube, SoundCloud)
YOUTUBE_API_KEY=your-youtube-api-key

# Blacklist Settings (optional)
BLACKLIST_ARTISTS=nsfw,explicit,blocked_artist
BLACKLIST_KEYWORDS=nsfw,explicit,blocked_keyword

# AI Moderation (optional)
OPENAI_API_KEY=your-openai-api-key

# Redis (optional - for caching)
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# WebSocket (optional)
NEXT_PUBLIC_WEBSOCKET_URL=wss://your-websocket-url

# Debug (optional - use real payment provider instead of mock)
NEXT_PUBLIC_USE_MOCK=true
